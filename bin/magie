#!/data/data/com.termux/files/usr/bin/bash
# magie — menu principal du Terminal Linux Magique
#   magie               → menu interactif
#   magie <commande>    → action directe (voir « magie aide »)
set -uo pipefail

DOSSIER="$HOME/.magie"
LISTE="$DOSSIER/modeles.txt"
ACTIF="$DOSSIER/modele_actif"
mkdir -p "$DOSSIER"

violet='\033[1;35m'; cyan='\033[1;36m'; vert='\033[1;32m'; jaune='\033[1;33m'; fin='\033[0m'

modele_actif() { cat "$ACTIF" 2>/dev/null || echo "llama3.2:3b"; }

serveur_ia() {
  if ! command -v ollama >/dev/null 2>&1; then
    echo -e "${jaune}➜ Installation du moteur d'IA (Ollama)…${fin}"
    pkg install -y ollama || { echo "✖ Impossible d'installer Ollama"; return 1; }
  fi
  if ! curl -s --max-time 2 http://127.0.0.1:11434/api/version >/dev/null 2>&1; then
    echo -e "${jaune}➜ Démarrage du moteur d'IA…${fin}"
    nohup ollama serve >"$DOSSIER/ollama.log" 2>&1 &
    for _ in $(seq 1 30); do
      curl -s --max-time 1 http://127.0.0.1:11434/api/version >/dev/null 2>&1 && return 0
      sleep 0.5
    done
    echo "✖ Échec du démarrage (voir $DOSSIER/ollama.log)"; return 1
  fi
}

lignes_modeles() { grep -v '^#' "$LISTE" | grep -v '^[[:space:]]*$'; }

liste_modeles() {
  echo -e "${cyan}IA gratuites disponibles :${fin}"
  local i=1 installes
  installes="$(ollama list 2>/dev/null | awk 'NR>1{print $1}')"
  while IFS='|' read -r nom taille desc; do
    local etat="  "
    if grep -qFx -e "$nom" -e "$nom:latest" <<<"$installes"; then etat="✅"; fi
    [ "$nom" = "$(modele_actif)" ] && etat="⭐"
    printf " %s %2d) %-18s %-7s %s\n" "$etat" "$i" "$nom" "$taille" "$desc"
    i=$((i + 1))
  done < <(lignes_modeles)
  echo -e "\n ✅ = téléchargé   ⭐ = modèle actif"
}

choisir_modele() {
  liste_modeles >&2
  echo >&2
  read -rp "Numéro du modèle (ou nom Ollama) : " choix
  [ -z "$choix" ] && return 1
  if [[ "$choix" =~ ^[0-9]+$ ]]; then
    lignes_modeles | sed -n "${choix}p" | cut -d'|' -f1
  else
    echo "$choix"
  fi
}

telecharger() {
  serveur_ia || return
  local m="${1:-}"
  [ -z "$m" ] && m="$(choisir_modele)" || true
  [ -z "$m" ] && return
  echo -e "${violet}🪄 Téléchargement de $m…${fin}"
  ollama pull "$m" && echo "$m" > "$ACTIF" && echo -e "${vert}✔ $m prêt et activé${fin}"
}

activer() {
  local m
  m="$(choisir_modele)" || return
  [ -n "$m" ] && echo "$m" > "$ACTIF" && echo -e "${vert}⭐ Modèle actif : $m${fin}"
}

supprimer() {
  serveur_ia || return
  ollama list
  read -rp "Nom du modèle à supprimer : " m
  [ -n "$m" ] && ollama rm "$m"
}

installer_ia() {
  echo -e "${violet}🪄 Installation d'un pack d'IA gratuites${fin}"
  echo " 1) Léger     : llama3.2:3b                         (~2 Go)"
  echo " 2) Complet   : llama3.2:3b + gemma3:4b + qwen2.5-coder:3b (~7 Go)"
  echo " 3) Mini      : llama3.2:1b                         (~1,3 Go)"
  read -rp "Votre choix [1] : " p
  case "${p:-1}" in
    2) for m in llama3.2:3b gemma3:4b qwen2.5-coder:3b; do telecharger "$m"; done; echo "llama3.2:3b" > "$ACTIF" ;;
    3) telecharger llama3.2:1b ;;
    *) telecharger llama3.2:3b ;;
  esac
}

serveur_web() {
  serveur_ia || return
  echo -e "${vert}✔ API d'IA disponible sur http://127.0.0.1:11434${fin}"
  echo "  Compatible avec les applis Android « Ollama » (ex. Ollama App, Maid)."
  echo "  Pour arrêter : magie stop"
}

stop_ia() { pkill -f "ollama serve" && echo "✔ Moteur d'IA arrêté" || echo "Le moteur n'était pas lancé"; }

linux() {
  echo -e "${vert}🐉 Entrée dans Kali Linux — tapez 'exit' pour revenir${fin}"
  kali
}

outils_kali() {
  echo -e "${cyan}🧰 Outils Kali${fin}"
  echo "   1) De base : nmap, sqlmap, hydra, nikto, john, metasploit… (recommandé)"
  echo "   2) Complet : tous les outils (kali-linux-headless, plusieurs Go)"
  read -rp "   Votre choix [1] : " c
  case "${c:-1}" in
    2) kali outils complet ;;
    *) kali outils ;;
  esac
}

infos() {
  command -v fastfetch >/dev/null 2>&1 && fastfetch || uname -a
  echo
  echo -e "${cyan}Modèle IA actif :${fin} $(modele_actif)"
  echo -e "${cyan}Espace libre     :${fin} $(df -h "$HOME" | awk 'NR==2{print $4}')"
  if command -v termux-battery-status >/dev/null 2>&1; then
    echo -e "${cyan}Batterie         :${fin} $(termux-battery-status 2>/dev/null | jq -r '"\(.percentage)% (\(.status))"' 2>/dev/null)"
  fi
}

raccourcis() {
  echo -e "${cyan}⌨  Raccourcis du terminal avancé${fin}"
  cat <<'TXT'

  Barre de touches      ESC | / - HOME ↑ END PGUP DEL
                        TAB CTRL ALT ~ ← ↓ → PGDN ⌨
  Glisser la barre →    champ de saisie texte (accents, emojis)
  Volume bas + touche   Ctrl + touche  (Vol↓ + C = Ctrl+C)
  Volume haut + touche  touches spéciales (Vol↑ + W = ↑, Vol↑ + E = Échap)

  Ctrl+R                recherche floue dans l'historique (fzf)
  Ctrl+T                chercher un fichier (fzf)
  Tab                   autocomplétion (commandes, fichiers, git, pkg…)
  z dossier             aller dans un dossier déjà visité (zoxide)
  Ctrl+Alt+C            nouvelle session ; Ctrl+Alt+← / → changer de session
  Bord gauche → glisser liste des sessions
  Appui long            copier / coller

  tmux                  Ctrl+B puis C (fenêtre), % ou " (couper l'écran), D (détacher)
  ll / arbre / voir     lister, arborescence, afficher un fichier en couleur
TXT
}

serveur_ssh() {
  command -v sshd >/dev/null 2>&1 || pkg install -y openssh || return 1
  if ! pgrep -x sshd >/dev/null 2>&1; then
    echo -e "${jaune}➜ Choisissez un mot de passe pour la connexion SSH :${fin}"
    passwd
    sshd && echo -e "${vert}✔ Serveur SSH lancé${fin}"
  else
    echo -e "${vert}✔ Serveur SSH déjà lancé${fin}"
  fi
  local ip
  ip="$(ifconfig 2>/dev/null | awk '/inet /{print $2}' | grep -v '^127\.' | head -n1)"
  echo "  Depuis un PC du même Wi-Fi :  ssh -p 8022 $(whoami)@${ip:-<IP-du-téléphone>}"
  echo "  Pour arrêter :  pkill sshd"
}

mise_a_jour() {
  yes | pkg upgrade -y
  command -v proot-distro >/dev/null 2>&1 && proot-distro login kali -- true >/dev/null 2>&1 && kali maj || true
  echo -e "${vert}✔ Tout est à jour${fin}"
}

aide() {
  cat <<EOF
🐉 magie — Terminal Kali Linux

  magie                  menu interactif
  kali                   entrer dans Kali Linux (aussi : magie linux)
  kali auto on|off       ouvrir Kali à chaque nouvelle session (ou non)
  kali outils            installer les outils Kali (nmap, sqlmap, hydra…)
  magie raccourcis       touches spéciales et raccourcis
  magie ssh              se connecter au téléphone depuis un PC
  magie infos            infos du téléphone
  magie maj              tout mettre à jour
  magie-installer        (ré)installer les outils du terminal avancé

  IA gratuites (option) :
  magie chat             discuter avec l'IA active
  magie installer-ia     installer un pack d'IA gratuites
  magie modeles          voir / télécharger des IA
  magie activer          changer d'IA active
  magie supprimer        supprimer une IA (libérer de la place)
  magie serveur          lancer l'API IA pour d'autres applis
  magie stop             arrêter le moteur d'IA
  ia "question"          réponse rapide de l'IA
EOF
}

menu() {
  while true; do
    clear
    echo -e "${violet}"
    cat <<'EOF'
   ╔══════════════════════════════════════════╗
   ║    🐉  TERMINAL KALI LINUX  🪄             ║
   ╚══════════════════════════════════════════╝
EOF
    echo -e "${fin}   IA active : ${vert}$(modele_actif)${fin}\n"
    echo "   1) 🐉 Entrer dans Kali Linux"
    echo "   2) 🧰 Installer les outils Kali"
    echo "   3) ⌨  Raccourcis et touches spéciales"
    echo "   4) 🔐 Serveur SSH (accès depuis un PC)"
    echo "   5) 📱 Infos du téléphone"
    echo "   6) 🔄 Tout mettre à jour"
    echo "   7) 🤖 Discuter avec l'IA"
    echo "   8) 📦 Installer un pack d'IA gratuites"
    echo "   9) 📚 Voir / télécharger / changer d'IA"
    echo "  10) 🗑  Supprimer une IA"
    echo "   0) 🚪 Quitter"
    echo
    read -rp "   Votre choix : " c
    case "$c" in
      1) linux ;;
      2) outils_kali ;;
      3) raccourcis ;;
      4) serveur_ssh ;;
      5) infos ;;
      6) mise_a_jour ;;
      7) ia ;;
      8) installer_ia ;;
      9) serveur_ia && liste_modeles && { echo; read -rp "Télécharger (t), activer (a) ou rien (Entrée) ? " r
         case "$r" in t|T) telecharger ;; a|A) activer ;; esac; } ;;
      10) supprimer ;;
      0|q) exit 0 ;;
      *) echo "Choix inconnu" ;;
    esac
    echo; read -rp "   Entrée pour revenir au menu…" _
  done
}

case "${1:-}" in
  "") menu ;;
  chat) shift; exec ia "$@" ;;
  installer-ia) installer_ia ;;
  modeles) serveur_ia && liste_modeles && { read -rp "Télécharger un modèle ? (o/N) " r; [[ "$r" =~ ^[oOyY] ]] && telecharger; true; } ;;
  telecharger) telecharger "${2:-}" ;;
  activer) activer ;;
  supprimer) supprimer ;;
  serveur) serveur_web ;;
  stop) stop_ia ;;
  linux|kali) linux ;;
  outils) outils_kali ;;
  raccourcis) raccourcis ;;
  ssh) serveur_ssh ;;
  infos) infos ;;
  maj) mise_a_jour ;;
  aide|-h|--help) aide ;;
  *) echo "Commande inconnue : $1"; aide; exit 1 ;;
esac
