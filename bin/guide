#!/data/data/com.termux/files/usr/bin/bash
# guide — explique ce que font les outils Kali (pas seulement leur nom)
#   guide                → liste tous les outils avec un résumé
#   guide nmap           → fiche détaillée d'un outil (rôle + exemples)
#   guide web            → cherche « web » dans les noms, catégories et résumés
set -uo pipefail

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
lime='\033[1;38;2;50;255;0m'; blanc='\033[0;97m'; gras='\033[1;97m'; jaune='\033[1;33m'; fin='\033[0m'

trouver_fichier() {
  for f in "$PREFIX/share/magie/config/kali-guide.txt" \
           "/usr/local/share/magie/config/kali-guide.txt" \
           "$HOME/.magie/config/kali-guide.txt" \
           "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." 2>/dev/null && pwd)/config/kali-guide.txt"; do
    [ -f "$f" ] && { echo "$f"; return 0; }
  done
  return 1
}
FICHIER="$(trouver_fichier)" || { echo "Guide introuvable (config/kali-guide.txt)."; exit 1; }

lister() {
  echo -e "${lime}🐉 Outils Kali — tapez « guide <nom> » pour le détail${fin}\n"
  awk -F'|' '/^@/{
    nom=$1; sub(/^@[ ]*/,"",nom); gsub(/[ ]+$/,"",nom);
    cat=$2; gsub(/^[ ]+|[ ]+$/,"",cat);
    res=$3; gsub(/^[ ]+/,"",res);
    printf "  \033[1;38;2;50;255;0m%-22s\033[0m \033[0;97m%-13s\033[0m %s\n", nom, "["cat"]", res
  }' "$FICHIER"
  echo -e "\n${jaune}  ⚠️ À utiliser uniquement sur vos appareils/réseaux ou avec autorisation.${fin}"
}

fiche() {
  local cible="$1" trouve=0
  awk -v cible="$cible" -F'|' '
    /^@/{
      nom=$1; sub(/^@[ ]*/,"",nom); gsub(/[ ]+$/,"",nom);
      cat=$2; gsub(/^[ ]+|[ ]+$/,"",cat);
      res=$3; gsub(/^[ ]+/,"",res);
      ligne=tolower(nom" "cat" "res);
      if (tolower(nom)==tolower(cible) || ligne ~ tolower(cible)) {
        aff=1; found=1;
        printf "\n\033[1;38;2;50;255;0m🐉 %s\033[0m  \033[0;97m[%s]\033[0m\n\033[1;97m%s\033[0m\n\n", nom, cat, res;
        next
      } else aff=0
    }
    aff && /^\$/{ line=$0; sub(/^\$[ ]*/,"",line); printf "   \033[1;38;2;50;255;0m$\033[0m %s\n", line; next }
    aff && NF{ print "   " $0 }
    END{ if(!found) exit 2 }
  ' "$FICHIER" && trouve=1
  if [ "$trouve" -eq 0 ]; then
    echo "Aucun outil « $cible » dans le guide. Liste : guide"
    return 1
  fi
}

case "${1:-}" in
  ""|liste|list) lister ;;
  -h|--help|aide) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) fiche "$1" ;;
esac
