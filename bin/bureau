#!/data/data/com.termux/files/usr/bin/bash
# bureau — un vrai bureau graphique Kali (XFCE) dans le téléphone, via VNC.
#   bureau installer     → installe le bureau XFCE + le serveur d'affichage dans Kali
#   bureau               → démarre le bureau et explique comment l'afficher
#   bureau fond [image]  → change le fond d'écran (défaut, ou votre photo)
#   bureau icones        → (re)crée les icônes du bureau (Terminal, Catalogue…)
#   bureau arreter       → arrête le bureau
# Pour VOIR le bureau : installez une appli « VNC Viewer » sur Android
# et connectez-vous à  localhost:1  (mot de passe défini à l'installation).
set -uo pipefail

NOM="kali"
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
ROOTFS="$PREFIX/var/lib/proot-distro/installed-rootfs/$NOM"
lime='\033[1;38;2;50;255;0m'; blanc='\033[0;97m'; jaune='\033[1;33m'; rouge='\033[1;31m'; fin='\033[0m'

dans_kali() { proot-distro login "$NOM" -- "$@"; }

fichier_fond_defaut() {
  for f in "$PREFIX/share/magie/config/fond-ecran.png" \
           "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." 2>/dev/null && pwd)/config/fond-ecran.png"; do
    [ -f "$f" ] && { echo "$f"; return 0; }
  done
  return 1
}

# Copie une image dans Kali et l'applique comme fond d'écran XFCE.
appliquer_fond() {
  local source="$1"
  [ -f "$source" ] || { echo -e "${rouge}✖ Image introuvable : $source${fin}"; return 1; }
  install -D -m 644 "$source" "$ROOTFS/root/.magie-fond.png" 2>/dev/null \
    || dans_kali bash -c 'cat > /root/.magie-fond.png' < "$source"
  # Applique tout de suite si le bureau tourne, et à chaque démarrage (xstartup s'en charge).
  dans_kali bash -c '
    export DISPLAY=:1
    if command -v xfconf-query >/dev/null 2>&1; then
      for p in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E "last-image$"); do
        xfconf-query -c xfce4-desktop -p "$p" -s /root/.magie-fond.png 2>/dev/null
      done
      # Valeurs par défaut pour les futurs écrans/espaces de travail
      xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitorVNC-0/workspace0/last-image \
        -n -t string -s /root/.magie-fond.png 2>/dev/null
      command -v xfdesktop >/dev/null 2>&1 && xfdesktop --reload 2>/dev/null
    fi
  ' 2>/dev/null || true
}

verifier_kali() {
  if ! command -v proot-distro >/dev/null 2>&1 || ! proot-distro login "$NOM" -- true >/dev/null 2>&1; then
    echo -e "${rouge}✖ Installez d'abord Kali :  kali installer${fin}"; exit 1
  fi
}

installer() {
  verifier_kali
  echo -e "${lime}🖥  Installation du bureau Kali (XFCE) — ~1 à 2 Go, Wi-Fi conseillé…${fin}"
  dans_kali bash -c '
    export DEBIAN_FRONTEND=noninteractive
    apt-get update &&
    apt-get install -y kali-desktop-xfce tigervnc-standalone-server dbus-x11 \
      xfonts-base xfonts-100dpi xfonts-75dpi at-spi2-core kali-menu &&
    apt-get clean
  ' || { echo -e "${rouge}✖ Installation incomplète. Réessayez : bureau installer${fin}"; exit 1; }

  echo -e "${lime}➜ Choisissez un mot de passe pour le bureau (6-8 caractères) :${fin}"
  dans_kali bash -c '
    mkdir -p ~/.vnc ~/.config/tigervnc
    vncpasswd
    # Écrit le mot de passe dans les deux emplacements (ancien et nouveau tigervnc)
    [ -f ~/.vnc/passwd ] && cp -f ~/.vnc/passwd ~/.config/tigervnc/passwd
    [ -f ~/.config/tigervnc/passwd ] && cp -f ~/.config/tigervnc/passwd ~/.vnc/passwd
    for dossier in ~/.vnc ~/.config/tigervnc; do
      cat > "$dossier/xstartup" <<XS
#!/bin/sh
unset SESSION_MANAGER DBUS_SESSION_BUS_ADDRESS
export XDG_RUNTIME_DIR=/tmp/runtime-root
[ -x /usr/bin/dbus-launch ] && eval "\$(dbus-launch --sh-syntax)"
# Applique le fond une fois XFCE demarre
( sleep 4
  if [ -f /root/.magie-fond.png ]; then
    for p in \$(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E "last-image\$"); do
      xfconf-query -c xfce4-desktop -p "\$p" -s /root/.magie-fond.png 2>/dev/null
    done
    xfdesktop --reload 2>/dev/null
  fi ) &
exec startxfce4
XS
      chmod +x "$dossier/xstartup"
    done
  '
  # Fond d'écran par défaut (thème noir / vert lime)
  local defaut; defaut="$(fichier_fond_defaut || true)"
  [ -n "$defaut" ] && appliquer_fond "$defaut"
  # Icônes sur le bureau (Terminal, Catalogue, Guide, Navigateur) — comme un ordinateur
  creer_raccourcis
  echo -e "${lime}✔ Bureau installé (fond + icônes). Lancez-le avec :  bureau${fin}"
  echo -e "   Installez une appli VNC Viewer sur Android (Play Store, gratuit)."
  echo -e "   Pour mettre votre photo en fond :  bureau fond /chemin/vers/image.jpg"
}

# Installe guide + catalogue (et leurs fichiers) DANS Kali, pour les icônes du bureau.
installer_outils_bureau() {
  local base="$PREFIX/share/magie"
  [ -d "$base" ] || base="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." 2>/dev/null && pwd)"
  install -D -m 755 "$base/bin/guide"     "$ROOTFS/usr/local/bin/guide"     2>/dev/null || true
  install -D -m 755 "$base/bin/catalogue" "$ROOTFS/usr/local/bin/catalogue" 2>/dev/null || true
  for f in kali-guide.txt kali-catalogue.txt; do
    install -D -m 644 "$base/config/$f" "$ROOTFS/usr/local/share/magie/config/$f" 2>/dev/null || true
  done
}

# Crée des icônes cliquables sur le bureau XFCE (comme un ordinateur).
creer_raccourcis() {
  installer_outils_bureau
  dans_kali bash -c '
    mkdir -p /root/Desktop
    ecrire() { # $1=fichier $2=Nom $3=commande $4=icone
      cat > "/root/Desktop/$1.desktop" <<D
[Desktop Entry]
Version=1.0
Type=Application
Name=$2
Exec=$3
Icon=$4
Terminal=$5
D
      chmod +x "/root/Desktop/$1.desktop"
      # Marque le lanceur comme fiable pour XFCE
      command -v gio >/dev/null 2>&1 && gio set "/root/Desktop/$1.desktop" metadata::xfce-exe-checksum "$(sha256sum "/root/Desktop/$1.desktop" | cut -d" " -f1)" 2>/dev/null || true
    }
    ecrire 00-terminal  "Terminal Kali"     "xfce4-terminal"                                  utilities-terminal        true
    ecrire 01-catalogue "Catalogue outils"  "xfce4-terminal --title=Catalogue -e catalogue"   system-software-install   true
    ecrire 02-guide     "Guide des outils"  "xfce4-terminal --title=Guide -e \"bash -c \\\"guide | less -R\\\"\"" help-browser  true
    ecrire 03-fichiers  "Fichiers"          "thunar"                                          system-file-manager       false
    command -v firefox        >/dev/null 2>&1 && ecrire 04-web "Navigateur Web" "firefox"        firefox-esr false
    command -v firefox-esr    >/dev/null 2>&1 && ecrire 04-web "Navigateur Web" "firefox-esr"    firefox-esr false
  ' 2>/dev/null || true
}

fond() {
  verifier_kali
  local source="${1:-}"
  if [ -z "$source" ]; then
    source="$(fichier_fond_defaut || true)"
    [ -z "$source" ] && { echo -e "${rouge}✖ Fond par défaut introuvable.${fin}"; exit 1; }
    echo -e "${lime}➜ Fond d'écran par défaut (thème Kali)…${fin}"
  else
    # Chemins pratiques : ~/storage/... pour les photos du téléphone
    case "$source" in
      "~/"*) source="$HOME/${source#\~/}" ;;
    esac
    [ -f "$source" ] || { echo -e "${rouge}✖ Image introuvable : $source${fin}"
      echo "   Astuce : vos photos sont dans  ~/storage/dcim  ou  ~/storage/downloads"; exit 1; }
    echo -e "${lime}➜ Fond d'écran : $source${fin}"
  fi
  appliquer_fond "$source" && echo -e "${lime}✔ Fond appliqué. (Si le bureau tourne, il se met à jour ; sinon au prochain démarrage.)${fin}"
}

# Corrige l'erreur « Could not migrate /root/.vnc to /root/.config/tigervnc »
# en normalisant la config VNC (mot de passe + xstartup présents aux deux endroits,
# et pas de migration bloquante).
reparer_vnc() {
  dans_kali bash -c '
    mkdir -p ~/.config/tigervnc
    # Récupère un mot de passe existant, où qu'"'"'il soit
    if [ ! -f ~/.config/tigervnc/passwd ] && [ -f ~/.vnc/passwd ]; then
      cp -f ~/.vnc/passwd ~/.config/tigervnc/passwd
    fi
    if [ ! -f ~/.vnc/passwd ] && [ -f ~/.config/tigervnc/passwd ]; then
      mkdir -p ~/.vnc; cp -f ~/.config/tigervnc/passwd ~/.vnc/passwd
    fi
    # Récupère un xstartup existant
    if [ ! -f ~/.config/tigervnc/xstartup ] && [ -f ~/.vnc/xstartup ]; then
      cp -f ~/.vnc/xstartup ~/.config/tigervnc/xstartup
    fi
    chmod +x ~/.config/tigervnc/xstartup ~/.vnc/xstartup 2>/dev/null
    chmod 600 ~/.config/tigervnc/passwd ~/.vnc/passwd 2>/dev/null
  ' 2>/dev/null || true
}

demarrer() {
  verifier_kali
  if ! dans_kali bash -c 'command -v vncserver >/dev/null'; then
    echo -e "${jaune}➜ Bureau pas encore installé.${fin}"; installer;
  fi
  reparer_vnc
  echo -e "${lime}🖥  Démarrage du bureau Kali…${fin}"
  dans_kali bash -c '
    mkdir -p /tmp/runtime-root
    vncserver -kill :1 >/dev/null 2>&1
    rm -f /tmp/.X11-unix/X1 /tmp/.X1-lock 2>/dev/null
    vncserver :1 -geometry 1280x720 -depth 24 -localhost no
  ' || { echo -e "${rouge}✖ Le bureau n'a pas démarré.${fin}"; exit 1; }
  cat <<EOF

$(printf "${lime}")✔ Bureau prêt !$(printf "${fin}")

  1) Installez une appli « VNC Viewer » sur Android (gratuit, Play Store).
  2) Ouvrez-la et connectez-vous à :  ${blanc}localhost:1${fin}
     (ou 127.0.0.1:5901)
  3) Entrez le mot de passe choisi à l'installation.

  Pour arrêter le bureau :  ${blanc}bureau arreter${fin}

EOF
}

arreter() {
  verifier_kali
  reparer_vnc
  dans_kali bash -c 'vncserver -kill :1 2>/dev/null' && echo -e "${lime}✔ Bureau arrêté${fin}" \
    || echo "Le bureau n'était pas lancé."
}

case "${1:-}" in
  installer) installer ;;
  fond) fond "${2:-}" ;;
  icones|raccourcis) verifier_kali; creer_raccourcis && echo -e "${lime}✔ Icônes du bureau recréées${fin}" ;;
  arreter|stop) arreter ;;
  ""|demarrer|start) demarrer ;;
  -h|--help|aide) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "Usage : bureau [installer|fond|icones|arreter]"; exit 1 ;;
esac
