#!/data/data/com.termux/files/usr/bin/bash
# kali — ouvre le terminal Kali Linux (sans root, via proot-distro)
#   kali                 → entrer dans Kali Linux (l'installe au premier lancement)
#   kali installer       → (ré)installer Kali Linux
#   kali maj             → mettre Kali à jour (apt full-upgrade)
#   kali francais        → passer Kali en français (locale fr_FR.UTF-8)
#   kali diagnostic      → vérifie proot-distro, Internet, espace disque
#   kali outils          → (ré)installer les outils Kali de base
#   kali outils complet  → installer TOUS les outils (kali-linux-headless)
#   kali guide [outil]   → guide : ce que fait chaque outil (+ exemples)
#   kali catalogue       → parcourir/installer les outils par catégorie
#   kali bureau          → bureau graphique XFCE (via VNC)
#   kali auto on|off     → ouvrir Kali automatiquement à chaque nouvelle session
#   kali -- commande     → lancer une commande dans Kali
set -uo pipefail

NOM="kali"
IMAGE="kalilinux/kali-rolling"   # image officielle Kali Linux (Docker Hub)
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
MAGIE="$PREFIX/share/magie"
DOSSIER="$HOME/.magie"
lime='\033[1;38;2;50;255;0m'; jaune='\033[1;33m'; rouge='\033[1;31m'; blanc='\033[0;97m'; fin='\033[0m'

# Sommes-nous déjà DANS une session proot / dans Kali ? (on ne peut pas y lancer proot-distro)
en_proot() {
  grep -qi '^ID=kali' /etc/os-release 2>/dev/null && return 0
  [ -n "${PROOT_TMP_DIR:-}${PROOT_L2S_DIR:-}${PROOT_NO_SECCOMP:-}" ] && return 0
  return 1
}
avertir_proot() {
  echo -e "${rouge}✖ Vous êtes déjà à l'intérieur de Kali (ou d'une session Linux).${fin}"
  echo -e "${jaune}➜ Tapez d'abord  ${blanc}exit${jaune}  pour revenir au terminal Android,${fin}"
  echo -e "${jaune}  puis relancez.  Si l'erreur persiste, fermez complètement l'appli et rouvrez-la.${fin}"
}

kali_installe() {
  en_proot && return 1
  command -v proot-distro >/dev/null 2>&1 && proot-distro login "$NOM" -- true >/dev/null 2>&1
}

fichier_config() {
  # Renvoie le chemin d'un fichier de config (installé dans l'APK ou dans le dépôt).
  if [ -f "$MAGIE/config/$1" ]; then
    echo "$MAGIE/config/$1"
  else
    echo "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)/config/$1"
  fi
}
fichier_theme() { fichier_config theme.bashrc; }

# Affiche l'état du système pour comprendre un échec d'installation.
diagnostic() {
  echo -e "${blanc}• proot-distro :${fin} $(command -v proot-distro >/dev/null 2>&1 && proot-distro --version 2>/dev/null | head -n1 || echo 'ABSENT')"
  local libre; libre="$(df -h "$HOME" 2>/dev/null | awk 'NR==2{print $4}')"
  echo -e "${blanc}• Espace libre :${fin} ${libre:-inconnu}"
  if curl -fsI --max-time 8 https://registry-1.docker.io/v2/ >/dev/null 2>&1 \
     || curl -fsI --max-time 8 https://auth.docker.io >/dev/null 2>&1; then
    echo -e "${blanc}• Internet (Docker Hub) :${fin} OK"
  else
    echo -e "${blanc}• Internet (Docker Hub) :${fin} ${rouge}injoignable${fin} (Wi-Fi ? données mobiles ?)"
  fi
  echo -e "${blanc}• Kali déjà installé :${fin} $(kali_installe && echo oui || echo non)"
}

# Installe les outils Kali (liste par défaut, ou le métapaquet complet).
installer_outils() {
  kali_installe || { echo -e "${rouge}✖ Installez d'abord Kali : kali installer${fin}"; return 1; }
  local paquets
  if [ "${1:-}" = complet ]; then
    paquets="kali-linux-headless"
    echo -e "${lime}➜ Installation de TOUS les outils Kali (kali-linux-headless, plusieurs Go)…${fin}"
  else
    paquets="$(grep -vE '^\s*#|^\s*$' "$(fichier_config kali-outils.txt)" | tr '\n' ' ')"
    echo -e "${lime}➜ Installation des outils Kali (nmap, sqlmap, hydra, metasploit…)…${fin}"
  fi
  echo -e "${jaune}   Cela peut prendre du temps et de l'espace. Wi-Fi conseillé.${fin}"
  proot-distro login "$NOM" -- bash -c "
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y $paquets
    apt-get clean
  " && echo -e "${lime}✔ Outils Kali installés. Exemples : nmap, sqlmap, hydra, msfconsole${fin}" \
    || echo -e "${jaune}➜ Certains outils n'ont pas pu être installés. Réessayez : kali outils${fin}"
}

installer() {
  if en_proot; then avertir_proot; return 1; fi
  echo -e "${lime}🐉 Installation de Kali Linux (image officielle $IMAGE)${fin}"
  echo -e "${jaune}   Wi-Fi conseillé : ~150 Mo à télécharger, puis la mise à jour de Kali.${fin}"

  # 1) proot-distro présent ET à jour (l'installation depuis une image Docker
  #    n'existe que dans les versions récentes de proot-distro).
  echo -e "${lime}➜ Vérification de proot-distro…${fin}"
  pkg install -y proot-distro >/dev/null 2>&1 || true
  yes | pkg upgrade -y proot-distro >/dev/null 2>&1 || true
  if ! command -v proot-distro >/dev/null 2>&1; then
    echo -e "${rouge}✖ proot-distro n'est pas installé. Lancez : pkg install proot-distro${fin}"
    return 1
  fi

  if ! kali_installe; then
    echo -e "${lime}➜ Téléchargement de Kali (l'erreur éventuelle s'affiche en dessous)…${fin}"
    local sortie
    if ! sortie="$(proot-distro install --name "$NOM" "$IMAGE" 2>&1 | tee /dev/tty; exit "${PIPESTATUS[0]}")"; then
      if printf '%s' "$sortie" | grep -qi "proot session"; then
        echo; avertir_proot; return 1
      fi
      echo
      echo -e "${rouge}✖ Le téléchargement de Kali a échoué.${fin}"
      echo -e "${jaune}Diagnostic :${fin}"
      diagnostic
      echo
      echo -e "Solutions à essayer :"
      echo -e "  1) Mettez tout à jour :   ${blanc}pkg update && pkg upgrade -y${fin}"
      echo -e "  2) Réessayez :            ${blanc}kali installer${fin}"
      echo -e "  3) Si « unknown distribution » : votre proot-distro est trop ancien,"
      echo -e "     mettez à jour Termux (F-Droid) puis  ${blanc}pkg upgrade proot-distro${fin}"
      return 1
    fi
  fi

  echo -e "${lime}➜ Configuration de Kali (mise à jour, outils de base)…${fin}"
  proot-distro login "$NOM" -- bash -c '
    export DEBIAN_FRONTEND=noninteractive
    apt-get update &&
    apt-get install -y --no-install-recommends \
      kali-linux-core sudo nano vim less bash-completion command-not-found \
      man-db curl wget git ca-certificates iproute2 iputils-ping procps
    apt-get clean
  ' || echo -e "${jaune}➜ Configuration partielle : relancez « kali maj » plus tard.${fin}"

  installer_outils
  francais_kali

  # Thème : fond noir, texte blanc, nom d'utilisateur vert lime
  mkdir -p "$PREFIX/tmp"
  cp "$(fichier_theme)" "$PREFIX/tmp/magie-theme.bashrc"
  proot-distro login --shared-tmp "$NOM" -- bash -c '
    grep -q "magie-theme" /root/.bashrc 2>/dev/null || { echo; cat /tmp/magie-theme.bashrc; } >> /root/.bashrc
  '
  rm -f "$PREFIX/tmp/magie-theme.bashrc"

  mkdir -p "$DOSSIER"
  touch "$DOSSIER/kali-auto"
  echo -e "${lime}✔ Kali Linux est prêt. Il s'ouvrira à chaque nouvelle session.${fin}"
  echo "   (pour revenir au terminal Android : « exit » ; désactiver : « kali auto off »)"
}

# Kali en français : installe la locale fr_FR.UTF-8 et l'active dans chaque session.
francais_kali() {
  echo -e "${lime}➜ Kali en français…${fin}"
  proot-distro login "$NOM" -- bash -c '
    export DEBIAN_FRONTEND=noninteractive
    if ! locale -a 2>/dev/null | grep -qiE "^fr_FR\.utf-?8$"; then
      apt-get update >/dev/null 2>&1
      apt-get install -y --no-install-recommends locales >/dev/null 2>&1
      sed -i "s/^# *fr_FR.UTF-8 UTF-8/fr_FR.UTF-8 UTF-8/" /etc/locale.gen
      grep -q "^fr_FR.UTF-8 UTF-8" /etc/locale.gen || echo "fr_FR.UTF-8 UTF-8" >> /etc/locale.gen
      locale-gen >/dev/null 2>&1
    fi
    grep -q "magie-francais" /root/.bashrc 2>/dev/null || cat >> /root/.bashrc <<"EOF2"

# magie-francais : tout en français
export LANGUAGE=fr_FR:fr
if locale -a 2>/dev/null | grep -qiE "^fr_FR\.utf-?8$"; then
  export LANG=fr_FR.UTF-8 LC_ALL=fr_FR.UTF-8
fi
EOF2
  ' || echo -e "${jaune}➜ Français partiel : relancez « kali francais » plus tard.${fin}"
}

case "${1:-}" in
  installer) installer ;;
  francais|français) kali_installe || installer || exit 1; francais_kali ;;
  maj)
    kali_installe || installer || exit 1
    proot-distro login "$NOM" -- bash -c 'apt-get update && DEBIAN_FRONTEND=noninteractive apt-get full-upgrade -y'
    francais_kali ;;
  outils) installer_outils "${2:-}" ;;
  diagnostic|diag) diagnostic ;;
  guide) shift; exec guide "$@" ;;
  catalogue) shift; exec catalogue "$@" ;;
  bureau) shift; exec bureau "$@" ;;
  auto)
    mkdir -p "$DOSSIER"
    case "${2:-}" in
      on)  touch "$DOSSIER/kali-auto"; echo "✔ Kali s'ouvrira à chaque nouvelle session" ;;
      off) rm -f "$DOSSIER/kali-auto"; echo "✔ Les nouvelles sessions restent dans le terminal Android" ;;
      *)   echo "Usage : kali auto on|off"; exit 1 ;;
    esac ;;
  --)
    shift
    if en_proot; then exec bash -c "$*"; fi
    kali_installe || installer || exit 1
    exec proot-distro login --shared-tmp "$NOM" -- "$@" ;;
  "")
    if en_proot; then
      echo -e "${lime}🐉 Vous êtes déjà dans Kali Linux.${fin} (tapez ${blanc}exit${fin} pour revenir au terminal Android)"
      exit 0
    fi
    kali_installe || installer || exit 1
    exec proot-distro login --shared-tmp "$NOM" ;;
  -h|--help|aide)
    sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "Commande inconnue : $1 (voir « kali aide »)"; exit 1 ;;
esac
